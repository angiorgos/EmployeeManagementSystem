<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.project.employeemanagementsystem.controller.AttendanceController">

    <top>
        <fx:include source="topbar.fxml" />
    </top>

    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <center>
        <BorderPane prefHeight="200.0" prefWidth="200.0">
            <!-- TOP: search bar / info -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets bottom="12" left="12" right="12" top="12" />
                    </BorderPane.margin>

                    <TextField fx:id="searchField" promptText="Search employee (name / id / department)..." HBox.hgrow="ALWAYS" />
                    <Label text="PC Time:" />
                    <Label fx:id="pcTimeLabel" text="--/--/---- --:--:--" />
                </HBox>
            </top>

            <!-- CENTER: employees table -->
            <center>
                <TableView fx:id="employeesTable" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets bottom="12" left="12" right="12" top="0" />
                    </BorderPane.margin>

                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="220" text="Name" />
                        <TableColumn fx:id="colDepartment" prefWidth="180" text="Department" />
                        <TableColumn fx:id="colRole" prefWidth="140" text="Role" />
                        <TableColumn fx:id="colStatus" prefWidth="120" text="Today Status" />
                        <TableColumn fx:id="colLastIn" prefWidth="160" text="Last Check In" />
                        <TableColumn fx:id="colLastOut" prefWidth="160" text="Last Check Out" />
                    </columns>
                </TableView>
            </center>

            <!-- RIGHT: actions panel -->
            <right>
                <VBox prefWidth="320" spacing="12" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets bottom="12" left="0" right="12" top="12" />
                    </BorderPane.margin>

                    <Label styleClass="section-title" text="Selected Employee" />

                    <VBox spacing="6" styleClass="card">
                        <padding>
                            <Insets bottom="12" left="12" right="12" top="12" />
                        </padding>

                        <Label fx:id="selectedNameLabel" text="—" />
                        <Label fx:id="selectedDeptLabel" text="—" />
                        <Label fx:id="selectedRoleLabel" text="—" />
                    </VBox>

                    <Label styleClass="section-title" text="Actions" />

                    <VBox spacing="10">
                        <Button fx:id="checkInBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCheckIn" styleClass="btn-primary" text="Check In (Arrival)" />

                        <Button fx:id="checkOutBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCheckOut" styleClass="btn-secondary" text="Check Out (Departure)" />
                    </VBox>

                    <VBox spacing="6" styleClass="card">
                        <padding>
                            <Insets bottom="12" left="12" right="12" top="12" />
                        </padding>

                        <Label text="Today Record" />
                        <Label fx:id="todayInLabel" text="Check In: —" />
                        <Label fx:id="todayOutLabel" text="Check Out: —" />
                    </VBox>

                    <Label fx:id="messageLabel" text="" wrapText="true" />
                    <VBox VBox.vgrow="ALWAYS" />
                </VBox>
            </right>

        </BorderPane>
    </center>

</BorderPane>
