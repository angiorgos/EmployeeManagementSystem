<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="768.0" prefWidth="1366.0"
            stylesheets="@../theme.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.project.employeemanagementsystem.controller.AttendanceController">

    <top>
        <fx:include source="topbar.fxml" />
    </top>
    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <center>
        <StackPane>

            <VBox spacing="20.0" style="-fx-background-color: #F3F4F6; -fx-padding: 30;">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <children>
                            <VBox>
                                <Label styleClass="page-title" text="Attendance Tracker" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                                <Label style="-fx-text-fill: #6B7280;" text="Monitor daily check-ins and working hours" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />

                            <HBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-padding: 8 15; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                                <FontIcon iconLiteral="mdi2c-clock-outline" iconColor="#3B82F6" iconSize="20"/>
                                <Label fx:id="pcTimeLabel" text="--:--:--" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #374151;"/>
                            </HBox>
                        </children>
                    </HBox>

                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="card" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <StackPane alignment="CENTER_LEFT">
                                    <TextField fx:id="searchField" promptText="Search Employee..."
                                               prefHeight="35.0" prefWidth="250.0"
                                               styleClass="text-field"
                                               style="-fx-padding: 0 10 0 35;" /> <FontIcon iconLiteral="mdi2m-magnify" iconColor="#9CA3AF" iconSize="18">
                                    <StackPane.margin>
                                        <Insets left="12.0" />
                                    </StackPane.margin>
                                </FontIcon>
                                </StackPane>
                                <Region HBox.hgrow="ALWAYS" />
                            </HBox>

                            <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                                <columns>
                                    <TableColumn fx:id="colId" prefWidth="50.0" text="#" />
                                    <TableColumn fx:id="colFirstName" prefWidth="120.0" text="First Name" />
                                    <TableColumn fx:id="colLastName" prefWidth="120.0" text="Last Name" />
                                    <TableColumn fx:id="colDepartment" prefWidth="150.0" text="Department" />
                                    <TableColumn fx:id="colLastIn" prefWidth="100.0" text="Last In" />
                                    <TableColumn fx:id="colLastOut" prefWidth="100.0" text="Last Out" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <VBox prefWidth="350.0" spacing="20.0">
                            <VBox styleClass="card" spacing="15.0" alignment="TOP_CENTER" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                                <Label text="Selected Employee" style="-fx-font-size: 14px; -fx-text-fill: #9CA3AF; -fx-font-weight: bold;"/>

                                <FontIcon iconLiteral="mdi2a-account-circle" iconSize="80" iconColor="#E5E7EB"/>

                                <VBox alignment="CENTER" spacing="5.0">
                                    <Label fx:id="selectedNameLabel" text="Select an employee" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                                    <Label fx:id="selectedRoleLabel" text="Role: -" style="-fx-text-fill: #6B7280;"/>
                                    <Label fx:id="selectedDeptLabel" text="Department: -" style="-fx-text-fill: #6B7280;"/>
                                </VBox>

                                <Region prefHeight="20.0" />

                                <VBox style="-fx-background-color: #F9FAFB; -fx-padding: 15; -fx-background-radius: 8;" spacing="10.0" maxWidth="Infinity">
                                    <Label text="Today's Activity" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                        <FontIcon iconLiteral="mdi2l-login" iconColor="#10B981" iconSize="18"/>
                                        <Label fx:id="todayInLabel" text="Check In: --:--" style="-fx-text-fill: #4B5563;"/>
                                    </HBox>
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                        <FontIcon iconLiteral="mdi2l-logout" iconColor="#EF4444" iconSize="18"/>
                                        <Label fx:id="todayOutLabel" text="Check Out: --:--" style="-fx-text-fill: #4B5563;"/>
                                    </HBox>
                                </VBox>

                                <Label fx:id="messageLabel" wrapText="true" textAlignment="CENTER" style="-fx-font-weight: bold;"/>

                                <HBox spacing="20.0" alignment="CENTER">
                                    <Button fx:id="checkInBtn" text="Check In" onAction="#onCheckIn"
                                            styleClass="btn-success"
                                            prefHeight="45.0" prefWidth="140.0"
                                            style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

                                    <Button fx:id="checkOutBtn" text="Check Out" onAction="#onCheckOut"
                                            styleClass="btn-danger"
                                            prefHeight="45.0" prefWidth="140.0"
                                            style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>
                </children>
            </VBox>

            <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="20.0" visible="false" style="-fx-background-color: #F3F4F6;">
                <ProgressIndicator styleClass="loading-spinner" prefWidth="60.0" prefHeight="60.0" />
                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="Loading Data" textFill="#111827">
                        <font><Font name="System Bold" size="20.0"/></font>
                    </Label>
                    <Label text="Please wait..." textFill="#6B7280">
                        <font><Font size="14.0"/></font>
                    </Label>
                </VBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>