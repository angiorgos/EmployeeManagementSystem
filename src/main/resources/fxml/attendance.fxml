<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1366.0"
            stylesheets="@../theme.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.project.employeemanagementsystem.controller.AttendanceController">

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <center>
        <BorderPane prefHeight="200.0" prefWidth="200.0">
            <!-- TOP: search bar / info -->
            <top>
                <HBox spacing="10" alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </BorderPane.margin>

                    <TextField fx:id="searchField" promptText="Search employee (name / id / department)..." HBox.hgrow="ALWAYS"/>
                    <Label text="PC Time:"/>
                    <Label fx:id="pcTimeLabel" text="--/--/---- --:--:--"/>
                </HBox>
            </top>

            <!-- CENTER: employees table -->
            <center>
                <TableView fx:id="employeesTable" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets top="0" right="12" bottom="12" left="12"/>
                    </BorderPane.margin>

                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                        <TableColumn fx:id="colName" text="Name" prefWidth="220"/>
                        <TableColumn fx:id="colDepartment" text="Department" prefWidth="180"/>
                        <TableColumn fx:id="colRole" text="Role" prefWidth="140"/>
                        <TableColumn fx:id="colStatus" text="Today Status" prefWidth="120"/>
                        <TableColumn fx:id="colLastIn" text="Last Check In" prefWidth="160"/>
                        <TableColumn fx:id="colLastOut" text="Last Check Out" prefWidth="160"/>
                    </columns>
                </TableView>
            </center>

            <!-- RIGHT: actions panel -->
            <right>
                <VBox spacing="12" prefWidth="320" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets top="12" right="12" bottom="12" left="0"/>
                    </BorderPane.margin>

                    <Label text="Selected Employee" styleClass="section-title"/>

                    <VBox spacing="6" styleClass="card">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <Label fx:id="selectedNameLabel" text="—"/>
                        <Label fx:id="selectedDeptLabel" text="—"/>
                        <Label fx:id="selectedRoleLabel" text="—"/>
                    </VBox>

                    <Label text="Actions" styleClass="section-title"/>

                    <VBox spacing="10">
                        <Button fx:id="checkInBtn" text="Check In (Arrival)"
                                mnemonicParsing="false" onAction="#onCheckIn"
                                maxWidth="1.7976931348623157E308" styleClass="btn-primary"/>

                        <Button fx:id="checkOutBtn" text="Check Out (Departure)"
                                mnemonicParsing="false" onAction="#onCheckOut"
                                maxWidth="1.7976931348623157E308" styleClass="btn-secondary"/>
                    </VBox>

                    <VBox spacing="6" styleClass="card">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <Label text="Today Record"/>
                        <Label fx:id="todayInLabel" text="Check In: —"/>
                        <Label fx:id="todayOutLabel" text="Check Out: —"/>
                    </VBox>

                    <Label fx:id="messageLabel" text="" wrapText="true"/>
                    <VBox VBox.vgrow="ALWAYS"/>
                </VBox>
            </right>

        </BorderPane>
    </center>

</BorderPane>
