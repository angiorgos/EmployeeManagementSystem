<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1366.0" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.project.employeemanagementsystem.controller.DashboardController">

    <top>
        <fx:include source="topbar.fxml" />
    </top>

    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #F3F4F6;">
            <VBox spacing="15.0" style="-fx-padding: 15; -fx-background-color: #F3F4F6;">

                <Label text="Dashboard Overview" textFill="#111827">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>

                <HBox spacing="20.0" alignment="CENTER">

                    <VBox styleClass="kpi-card, card-blue" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-title" text="Total Employees"/>
                        <Label fx:id="totalEmployeesLabel" styleClass="kpi-value" text="0"/>
                    </VBox>

                    <VBox styleClass="kpi-card, card-green" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-title" text="Working Today"/>
                        <Label fx:id="workingTodayLabel" styleClass="kpi-value" text="0"/>
                    </VBox>

                    <VBox styleClass="kpi-card, card-orange" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-title" text="On Leave Today"/>
                        <Label fx:id="onLeaveLabel" styleClass="kpi-value" text="0"/>
                    </VBox>

                    <VBox styleClass="kpi-card, card-red" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-title" text="Pending Requests"/>
                        <Label fx:id="pendingRequestsLabel" styleClass="kpi-value" text="0"/>
                    </VBox>

                </HBox>
                <GridPane hgap="15.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="280.0" prefHeight="280.0" vgrow="NEVER" /> <RowConstraints minHeight="280.0" prefHeight="280.0" vgrow="NEVER" />
                    </rowConstraints>

                    <children>
                        <VBox styleClass="chart-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label styleClass="card-title" text="Hires Overview (Monthly)" />
                            <WebView fx:id="hiresWebView" VBox.vgrow="ALWAYS" />
                        </VBox>

                        <VBox styleClass="chart-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label styleClass="card-title" text="Employees per Department" />
                            <WebView fx:id="deptWebView" VBox.vgrow="ALWAYS" />
                        </VBox>

                        <VBox styleClass="chart-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label styleClass="card-title" text="Attendance (Hours/Week)" />
                            <WebView fx:id="attendanceWebView" VBox.vgrow="ALWAYS" />
                        </VBox>

                        <VBox styleClass="chart-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label styleClass="card-title" text="Leave Statistics" />
                            <WebView fx:id="leavesWebView" VBox.vgrow="ALWAYS" />
                        </VBox>
                    </children>
                </GridPane>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>