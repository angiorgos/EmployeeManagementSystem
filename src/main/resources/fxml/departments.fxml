<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="768.0" prefWidth="1366.0"
            stylesheets="@../theme.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.project.employeemanagementsystem.controller.DepartmentController">

    <top>
        <fx:include source="topbar.fxml"/>
    </top>
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <center>
        <StackPane>

            <!-- Table View -->
            <VBox fx:id="tableViewContainer" spacing="20.0" style="-fx-padding: 20; -fx-background-color: #F3F4F6;">
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label styleClass="page-title" text="Departments Management"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0"
                      style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <TextField fx:id="searchField" prefWidth="250" promptText="Search by name..."
                               styleClass="search-field"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#handleAddDepartment" styleClass="btn-primary" text="+ Add New"/>
                    <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Refresh"/>
                </HBox>

                <TableView fx:id="departmentTable" styleClass="styled-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idCol" prefWidth="50.0" text="ID"/>
                        <TableColumn fx:id="nameCol" prefWidth="180.0" text="Name"/>
                        <TableColumn fx:id="employeeCountCol" prefWidth="180.0" text="Employees"/>
                        <TableColumn fx:id="actionCol" prefWidth="200.0" text="Actions"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Form View -->
            <VBox fx:id="formViewContainer" spacing="20.0"
                  style="-fx-padding: 30; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);"
                  visible="false">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button onAction="#handleBackToTable" styleClass="btn-secondary" text="← Back"/>
                    <Label fx:id="formTitle" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="New Department"/>
                </HBox>
                <Separator/>

                <GridPane hgap="20.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Department Name *" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="departmentNameField" styleClass="search-field"/>
                    </VBox>

                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Description" style="-fx-font-weight: bold;"/>
                        <TextArea fx:id="departmentDescriptionField" prefRowCount="5"/>
                    </VBox>

                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>
                </GridPane>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button onAction="#handleBackToTable" styleClass="btn-secondary" text="Cancel"/>
                    <Button onAction="#handleSaveDepartment" prefWidth="150" styleClass="btn-primary" text="Save Department"/>
                </HBox>
            </VBox>

            <!-- Loading Overlay -->
            <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="20.0" style="-fx-background-color: #F3F4F6;">
                <ProgressIndicator styleClass="loading-spinner" prefWidth="60.0" prefHeight="60.0"/>
                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="Loading Departments" textFill="#111827">
                        <font><Font name="System Bold" size="20.0"/></font>
                    </Label>
                    <Label text="Please wait..." textFill="#6B7280">
                        <font><Font size="14.0"/></font>
                    </Label>
                </VBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
