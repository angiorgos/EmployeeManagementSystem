                                 <children>
                                    <Button fx:id="CreateDepartmentButton" alignment="BOTTOM_LEFT" mnemonicParsing="false" onAction="#onCreateDepartment" styleClass="btn-primary" text="Create Department" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox prefHeight="627.0" prefWidth="40.0" />
