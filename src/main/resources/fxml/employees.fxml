<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1366.0" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.project.employeemanagementsystem.controller.EmployeesController">

    <top><fx:include source="topbar.fxml" /></top>
    <left><fx:include source="sidebar.fxml" /></left>

    <center>
        <StackPane>

            <VBox fx:id="tableViewContainer" spacing="20.0" style="-fx-padding: 20; -fx-background-color: #F3F4F6;">

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label styleClass="page-title" text="Employee Management" />
                    <Region HBox.hgrow="ALWAYS" />

                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <StackPane alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Search Employee..."
                                   prefHeight="35.0" prefWidth="250.0"
                                   styleClass="text-field"
                                   style="-fx-padding: 0 10 0 35;" /> <FontIcon iconLiteral="mdi2m-magnify" iconColor="#9CA3AF" iconSize="18">
                        <StackPane.margin>
                            <Insets left="12.0" />
                        </StackPane.margin>
                    </FontIcon>
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleAddEmployee" styleClass="btn-primary" text="+ Add New" />
                    <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Refresh">
                        <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="16"/></graphic>
                    </Button>
                </HBox>

                <TableView fx:id="employeeTable" styleClass="styled-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colFirstName" prefWidth="120.0" text="First Name" />
                        <TableColumn fx:id="colLastName" prefWidth="120.0" text="Last Name" />
                        <TableColumn fx:id="colDepartment" prefWidth="150.0" text="Department" />
                        <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email" />
                        <TableColumn fx:id="colPhone" prefWidth="110.0" text="Phone" />
                        <TableColumn fx:id="colSalary" prefWidth="100.0" text="Salary (€)" />
                        <TableColumn fx:id="colActions" prefWidth="180.0" text="Actions" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>

            </VBox>

            <VBox fx:id="formViewContainer" spacing="20.0" style="-fx-padding: 30; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" visible="false">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button onAction="#handleBackToTable" styleClass="btn-secondary" text="← Back" />
                    <Label fx:id="formTitle" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="New Employee" />
                </HBox>
                <Separator />

                <GridPane hgap="20.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label style="-fx-font-weight: bold;" text="First Name *" />
                        <TextField fx:id="firstNameField" styleClass="search-field" />
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label style="-fx-font-weight: bold;" text="Last Name *" />
                        <TextField fx:id="lastNameField" styleClass="search-field" />
                    </VBox>

                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label style="-fx-font-weight: bold;" text="Email *" />
                        <TextField fx:id="emailField" styleClass="search-field" />
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label style="-fx-font-weight: bold;" text="Phone" />
                        <TextField fx:id="phoneField" styleClass="search-field" />
                    </VBox>

                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label style="-fx-font-weight: bold;" text="SSN / AFM *" />
                        <TextField fx:id="ssnField" styleClass="search-field" />
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label style="-fx-font-weight: bold;" text="Department" />
                        <ComboBox fx:id="departmentCombo" maxWidth="Infinity" styleClass="search-field" />
                    </VBox>

                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label style="-fx-font-weight: bold;" text="Salary (€)" />
                        <TextField fx:id="salaryField" promptText="0.00" styleClass="search-field" />
                    </VBox>

                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <Label style="-fx-font-weight: bold;" text="Hire Date *" />
                        <DatePicker fx:id="hireDateField" maxWidth="Infinity" styleClass="search-field" />
                    </VBox>

                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>

                <Region VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button onAction="#handleBackToTable" styleClass="btn-secondary" text="Cancel" />
                    <Button onAction="#handleSaveEmployee" prefWidth="150" styleClass="btn-primary" text="Save Employee" />
                </HBox>

            </VBox>

            <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="20.0" style="-fx-background-color: #F3F4F6;">
                <ProgressIndicator styleClass="loading-spinner" prefWidth="60.0" prefHeight="60.0" />
                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="Loading Employees" textFill="#111827">
                        <font><Font name="System Bold" size="20.0"/></font>
                    </Label>
                    <Label text="Please wait..." textFill="#6B7280">
                        <font><Font size="14.0"/></font>
                    </Label>
                </VBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>