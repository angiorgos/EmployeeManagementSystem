<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.project.employeemanagementsystem.controller.EmployeeController">
   <children>
      <TabPane id="mainTabPane" prefHeight="400.0" prefWidth="600.0" stylesheets="@../theme.css" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <tabs>
          <Tab text="Employees List">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <VBox layoutX="160.0" layoutY="14.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <padding>
                              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="538.0" spacing="10.0">
                                 <children>
                                    <Label prefHeight="30.0" prefWidth="243.0" styleClass="page-title" text="Manage Employees" HBox.hgrow="ALWAYS" />
                                    <TextField id="searchField" promptText="Search.." styleClass="text-field" />
                                    <Button mnemonicParsing="false" prefHeight="32.0" prefWidth="142.0" styleClass="btn-primary" text="Add employee" />
                                 </children>
                              </HBox>
                              <TableView id="employeesTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                <columns>
                                  <TableColumn prefWidth="90.0" styleClass="table-view" text="Full Name" />
                                  <TableColumn prefWidth="70.0" styleClass="table-view" text="Email" />
                                    <TableColumn prefWidth="100.0" styleClass="table-view" text="Department" />
                                    <TableColumn prefWidth="75.0" styleClass="table-view" text="Role" />
                                    <TableColumn prefWidth="75.0" styleClass="table-view" text="Status" />
                                    <TableColumn prefWidth="100.0" styleClass="table-view" text="Information" />
                                </columns>
                              </TableView>
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="Employee Management">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <padding>
                              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
                                 <children>
                                    <Label prefHeight="35.0" prefWidth="308.0" styleClass="page-title" text="Export payment file to PDF">
                                       <font>
                                          <Font size="19.0" />
                                       </font>
                                    </Label>
                                    <Button fx:id="btnExportPdf" mnemonicParsing="false" styleClass="btn-primary" text="Download PDF" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
