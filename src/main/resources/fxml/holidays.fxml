<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1366.0" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.project.employeemanagementsystem.controller.HolidaysController">

   <top>
      <fx:include source="topbar.fxml" />
   </top>

   <left>
      <fx:include source="sidebar.fxml" />
   </left>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="page-title" text="Holiday Scheduling" />
                  <Label style="-fx-text-fill: #6B7280;" text="Add, remove or edit Holidays." />
                  <HBox prefHeight="292.0" prefWidth="1066.0" spacing="10.0" VBox.vgrow="ALWAYS">
                     <children>
                        <TableView fx:id="holidaysTable" prefHeight="544.0" prefWidth="430.0" HBox.hgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="holidaysID" text="ID" prefWidth="75.0" />
                              <TableColumn fx:id="holidaysName" text="Name" prefWidth="250.0" />
                              <TableColumn fx:id="holidaysDate" text="Date" prefWidth="200.0" />
                           </columns>
                        </TableView>

                        <!-- Holiday Scheduling VBox - fixed -->
                        <VBox prefHeight="687.0" prefWidth="279.0">
                           <children>
                              <VBox prefHeight="206.0" prefWidth="279.0" spacing="15.0" styleClass="card">
                                 <children>
                                    <Label styleClass="card-title" text="Edit Table" />
                                    <HBox spacing="15.0">
                                       <children>
                                          <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label text="Holiday Name" />
                                                <TextField fx:id="holidaysNameField" promptText="Enter Holiday Name..." />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <HBox spacing="15.0">
                                       <children>
                                          <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label text="Holiday Date" />
                                                <DatePicker fx:id="holidaysDatePicker" promptText="Select Date" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                       <children>
                                          <Button fx:id="holidaysRemoveBtn" text="Remove" styleClass="btn-danger" onAction="#handleRemoveHoliday"/>
                                          <Button fx:id="holidaysAddBtn" text="Add" styleClass="btn-primary" onAction="#handleAddOrUpdateHoliday"/>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </BorderPane.margin>
      </VBox>
   </center>

</BorderPane>
