<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="768.0"
            prefWidth="1366.0"
            stylesheets="@../theme.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.project.employeemanagementsystem.controller.LeavesController">

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <!-- WRITE REQUEST TAB -->
                <Tab text="Write a Leave Request">
                    <content>
                        <VBox spacing="15">
                            <padding>
                                <Insets top="30" right="30" bottom="30" left="30"/>
                            </padding>

                            <VBox spacing="15" styleClass="card">

                                <GridPane hgap="30" vgap="20">
                                    <padding>
                                        <Insets top="20" right="20" bottom="20" left="20"/>
                                    </padding>

                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <!-- Row 0 -->
                                    <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                        <Label text="First Name"/>
                                        <TextField fx:id="firstNameField"/>
                                    </VBox>

                                    <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                        <Label text="Last Name"/>
                                        <TextField fx:id="lastNameField"/>
                                    </VBox>

                                    <!-- Row 1 -->
                                    <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                        <Label text="Email"/>
                                        <TextField fx:id="emailField"/>
                                    </VBox>

                                    <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                        <Label text="Phone Number"/>
                                        <TextField fx:id="phoneField"/>
                                    </VBox>

                                    <!-- Row 2 -->
                                    <VBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="0">
                                        <Label text="Leave Type"/>
                                        <ComboBox fx:id="typeCombo"/>
                                    </VBox>

                                    <VBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                        <Label text="Remaining Days"/>
                                        <Label fx:id="remainingDaysLabel" text="Select a type..."/>
                                    </VBox>

                                    <!-- Row 3 -->
                                    <VBox spacing="5" GridPane.rowIndex="3" GridPane.columnIndex="0">
                                        <Label text="Start Date"/>
                                        <DatePicker fx:id="startDatePicker"/>
                                    </VBox>

                                    <VBox spacing="5" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                        <Label text="End Date"/>
                                        <DatePicker fx:id="endDatePicker"/>
                                    </VBox>

                                </GridPane>

                                <TextArea fx:id="reasonArea"
                                          prefHeight="120"
                                          promptText="Reason for leave"/>

                                <HBox spacing="10" alignment="CENTER_RIGHT">
                                    <Button text="Clear"
                                            styleClass="btn-danger"
                                            onAction="#handleClear"/>
                                    <Button text="Submit"
                                            styleClass="btn-primary"
                                            onAction="#handleSubmit"/>
                                </HBox>

                            </VBox>
                        </VBox>
                    </content>
                </Tab>

                <!-- REVIEW TAB -->
                <Tab text="Review Requests">
                    <content>
                        <fx:include source="leaves2.fxml"/>
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </center>

</BorderPane>
