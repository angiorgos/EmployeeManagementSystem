<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1366.0" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.project.employeemanagementsystem.controller.LeaveTypesController">

    <top>
        <fx:include source="topbar.fxml" />
    </top>

    <left>
        <fx:include source="sidebar.fxml" />
    </left>
    <center>
        <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <VBox prefHeight="627.0" prefWidth="398.0" spacing="10.0" styleClass="card">
                    <children>
                        <Label styleClass="card-title" text="Leave Types" />
                        <TableView fx:id="leaveTypesTable" prefHeight="558.0" prefWidth="273.0">
                            <columns>
                                <TableColumn fx:id="leaveIDColumn" prefWidth="75.0" text="ID" />
                                <TableColumn fx:id="leaveNameColumn" prefWidth="154.0" text="Leave Name" />
                                <TableColumn fx:id="leaveMaxDaysColumn" prefWidth="77.0" text="Max Days" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <VBox prefHeight="687.0" prefWidth="279.0">
                    <children>
                        <HBox prefHeight="169.0" prefWidth="110.0" />
                        <VBox prefHeight="206.0" prefWidth="279.0" spacing="15.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Leaves Editor" />
                                <HBox spacing="15.0">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Leave Name" />
                                                <TextField fx:id="leaveNameField" promptText="Enter Leave Name..." />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox spacing="15.0">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Max Days" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                        <TextField fx:id="leaveMaxDaysField" promptText="Enter Max Days Owed..." />
                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <children>
                                        <Button fx:id="leaveRemoveBtn" styleClass="btn-danger" text="Remove" />
                                        <Button fx:id="leaveSaveBtn" styleClass="btn-primary" text="Save Changes" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
            <BorderPane.margin>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </BorderPane.margin>
        </HBox>
    </center>
</BorderPane>
