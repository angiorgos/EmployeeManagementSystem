<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="768.0" prefWidth="1366.0"
            stylesheets="@../theme.css"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.project.employeemanagementsystem.controller.LeaveTypesController">

    <top><fx:include source="topbar.fxml" /></top>
    <left><fx:include source="sidebar.fxml" /></left>

    <center>
        <StackPane>
            <VBox spacing="20.0" style="-fx-padding: 20; -fx-background-color: #F3F4F6;">

                <VBox spacing="5.0">
                    <Label styleClass="page-title" text="Leave Types Management" />
                    <Label style="-fx-text-fill: #6B7280;" text="Configure available leave categories and their annual limits." />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <StackPane alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Search types..."
                                   prefHeight="35.0" prefWidth="250.0"
                                   styleClass="text-field"
                                   style="-fx-padding: 0 10 0 35;" />
                        <FontIcon iconLiteral="mdi2m-magnify" iconColor="#9CA3AF" iconSize="18">
                            <StackPane.margin><Insets left="12.0" /></StackPane.margin>
                        </FontIcon>
                    </StackPane>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Refresh" prefHeight="35.0">
                        <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="16"/></graphic>
                    </Button>
                </HBox>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;">
                            <TableView fx:id="leaveTypesTable" styleClass="styled-table" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="leaveTypesID" prefWidth="70.0" text="ID" />
                                    <TableColumn fx:id="leaveTypesName" prefWidth="250.0" text="Leave Category Name" />
                                    <TableColumn fx:id="leaveTypesMaxDays" prefWidth="150.0" text="Max Days / Year" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            </TableView>
                        </VBox>

                        <VBox prefWidth="350.0" spacing="20.0" styleClass="card" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <children>
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Edit Details" />
                                <Separator />

                                <VBox spacing="8.0">
                                    <Label style="-fx-font-weight: bold;" text="Leave Name *" />
                                    <TextField fx:id="leaveTypesNameField" promptText="e.g. Annual Leave" prefHeight="35.0" />
                                </VBox>

                                <VBox spacing="8.0">
                                    <Label style="-fx-font-weight: bold;" text="Max Days Owed *" />
                                    <TextField fx:id="leaveTypesMaxDaysField" promptText="e.g. 25" prefHeight="35.0" />
                                </VBox>

                                <Region VBox.vgrow="ALWAYS" />

                                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                    <Button fx:id="leaveTypesRemoveBtn" onAction="#handleRemoveLeaveType" styleClass="btn-danger" text="Delete" prefWidth="100.0" prefHeight="35.0" />
                                    <Button fx:id="leaveTypesAddBtn" onAction="#handleAddOrUpdateLeaveType" styleClass="btn-primary" text="Save Type" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="35.0" />
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </VBox>

            <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="20.0" style="-fx-background-color: white;" visible="false">
                <ProgressIndicator styleClass="loading-spinner" prefWidth="60.0" prefHeight="60.0" />
                <Label text="Loading Settings..." textFill="#111827" style="-fx-font-weight: bold; -fx-font-size: 20px;" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>