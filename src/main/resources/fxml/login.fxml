<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.project.employeemanagementsystem.controller.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Employee Management System">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <Label text="Login" textFill="#5e5e5e">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <TextField fx:id="usernameField" promptText="Username" maxWidth="250.0" />

    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="250.0" />

    <Button text="Είσοδος" onAction="#handleLogin" prefWidth="250.0" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;" />

    <Label fx:id="errorLabel" textFill="RED" />
</VBox>