<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="500.0" spacing="25.0"
      style="-fx-background-color: white;"
      stylesheets="@../theme.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.project.employeemanagementsystem.controller.LoginController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Employee Management System" textFill="#111827">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <Label text="Login" textFill="#6B7280">
        <font>
            <Font size="16.0" />
        </font>
    </Label>

    <TextField fx:id="usernameField" promptText="Username" maxWidth="350.0" prefHeight="45.0" style="-fx-font-size: 14px;" />

    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="350.0" prefHeight="45.0" style="-fx-font-size: 14px;" />

    <Button text="Είσοδος" onAction="#handleLogin" maxWidth="350.0" prefHeight="50.0" styleClass="btn-primary">
        <font>
            <Font name="System Bold" size="16.0"/>
        </font>
    </Button>

    <Label fx:id="errorLabel" textFill="#EF4444" style="-fx-font-size: 14px;" />
</VBox>