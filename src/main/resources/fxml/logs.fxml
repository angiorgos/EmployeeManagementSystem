<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="768.0" prefWidth="1366.0"
            stylesheets="@../theme.css"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.project.employeemanagementsystem.controller.LogsController">

    <top><fx:include source="topbar.fxml" /></top>
    <left><fx:include source="sidebar.fxml" /></left>

    <center>
        <StackPane>
            <VBox fx:id="tableViewContainer" spacing="20.0" style="-fx-padding: 20; -fx-background-color: #F3F4F6;">

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label styleClass="page-title" text="System Logs &amp; Audit" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">

                    <DatePicker fx:id="dateFilter" prefHeight="35.0" prefWidth="160.0" promptText="Filter by Date" />

                    <StackPane alignment="CENTER_LEFT" HBox.hgrow="NEVER">
                        <TextField fx:id="searchField" promptText="Search actions or users..."
                                   prefHeight="35.0" prefWidth="300.0"
                                   styleClass="text-field"
                                   style="-fx-padding: 0 10 0 35;" />
                        <FontIcon iconLiteral="mdi2m-magnify" iconColor="#9CA3AF" iconSize="18">
                            <StackPane.margin>
                                <Insets left="12.0" />
                            </StackPane.margin>
                        </FontIcon>
                    </StackPane>

                    <Button onAction="#onResetFilters" styleClass="btn-secondary" text="Reset" prefHeight="35.0" />

                    <Region HBox.hgrow="ALWAYS" />

                    <HBox spacing="10">
                        <Button onAction="#onRefresh" styleClass="btn-secondary" text="Refresh" prefHeight="35.0">
                            <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="16"/></graphic>
                        </Button>
                        <Button onAction="#onClearLogs" styleClass="btn-danger" text="Clear History" prefHeight="35.0" />
                    </HBox>
                </HBox>

                <TableView fx:id="logsTable" styleClass="styled-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTime" prefWidth="180.0" text="Timestamp" />
                        <TableColumn fx:id="colUser" prefWidth="150.0" text="User" />
                        <TableColumn fx:id="colAction" prefWidth="600.0" text="Action Performed" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>

            </VBox>

            <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="20.0" style="-fx-background-color: white;" visible="false">
                <ProgressIndicator styleClass="loading-spinner" prefWidth="60.0" prefHeight="60.0" />
                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="Loading System Logs" textFill="#111827">
                        <font><Font name="System Bold" size="20.0"/></font>
                    </Label>
                    <Label text="Please wait..." textFill="#6B7280">
                        <font><Font size="14.0"/></font>
                    </Label>
                </VBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>