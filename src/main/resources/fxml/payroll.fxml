<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1366.0" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.project.employeemanagementsystem.controller.PayrollController">

    <top> <fx:include source="topbar.fxml" /> </top>
    <left> <fx:include source="sidebar.fxml" /> </left>

    <center>
        <StackPane>

            <VBox spacing="20.0" style="-fx-background-color: #F3F4F6;">
                <padding> <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /> </padding>
                <children>

                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <children>
                            <VBox>
                                <Label styleClass="page-title" text="Payroll Management" />
                                <Label style="-fx-text-fill: #6B7280;" text="Manage salaries, payments and settings" />
                            </VBox>

                            <Region HBox.hgrow="ALWAYS" />

                            <HBox spacing="15.0">
                                <VBox alignment="CENTER_LEFT" prefHeight="60" prefWidth="150" style="-fx-padding: 10; -fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8;" styleClass="card-flat-orange">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" text="Pending Payments" />
                                    <Label fx:id="lblPendingCount" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;" text="0" />
                                </VBox>
                            </HBox>
                        </children>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                        <DatePicker fx:id="monthPicker" prefWidth="140.0" promptText="Select Period" />
                        <StackPane alignment="CENTER_LEFT">
                            <TextField fx:id="searchField" promptText="Search Employee..."
                                       prefHeight="35.0" prefWidth="250.0"
                                       styleClass="text-field"
                                       style="-fx-padding: 0 10 0 35;" /> <FontIcon iconLiteral="mdi2m-magnify" iconColor="#9CA3AF" iconSize="18">
                            <StackPane.margin>
                                <Insets left="12.0" />
                            </StackPane.margin>
                        </FontIcon>
                        </StackPane>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnFinalize" onAction="#finalizePayments" styleClass="btn-success" text="Confirm &amp; Pay">
                            <graphic> <FontIcon iconColor="white" iconLiteral="mdi2c-check-circle" /> </graphic>
                        </Button>

                        <Button onAction="#exportToExcel" styleClass="btn-success" text="Export Excel">
                            <graphic> <FontIcon iconColor="white" iconLiteral="mdi2f-file-excel" /> </graphic>
                        </Button>
                        <Button onAction="#openSettingsDialog" styleClass="btn-secondary" text="Config">
                            <graphic> <FontIcon iconColor="#374151" iconLiteral="mdi2c-cog" /> </graphic>
                        </Button>
                        <Button fx:id="btnGenerate" onAction="#generatePayroll" styleClass="btn-primary" text="Generate Draft">
                            <graphic> <FontIcon iconColor="white" iconLiteral="mdi2c-calculator" /> </graphic>
                        </Button>
                    </HBox>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 0;" styleClass="card" VBox.vgrow="ALWAYS">
                        <TableView fx:id="payrollTable" style="-fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="50.0" text="#" />
                                <TableColumn fx:id="colSsn" prefWidth="100.0" text="SSN" />
                                <TableColumn fx:id="colName" prefWidth="200.0" text="Employee" />
                                <TableColumn fx:id="colMonth" prefWidth="100.0" text="Month" />
                                <TableColumn fx:id="colGross" prefWidth="100.0" text="Gross (€)" />
                                <TableColumn fx:id="colDeductions" prefWidth="100.0" text="Deductions" />
                                <TableColumn fx:id="colEmployerTax" prefWidth="100.0" text="Employer Cost" />
                                <TableColumn fx:id="colAmount" prefWidth="120.0" style="-fx-font-weight: bold;" text="NET PAY (€)" />
                                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                                <TableColumn fx:id="colActions" prefWidth="100.0" text="Actions" />
                            </columns>
                            <columnResizePolicy> <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /> </columnResizePolicy>
                        </TableView>
                    </VBox>

                </children>
            </VBox>

            <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="20.0" style="-fx-background-color: #F3F4F6;">
                <ProgressIndicator styleClass="loading-spinner" prefWidth="60.0" prefHeight="60.0" />
                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="Loading Payroll Data" textFill="#111827">
                        <font><Font name="System Bold" size="20.0"/></font>
                    </Label>
                    <Label text="Calculating salaries and taxes..." textFill="#6B7280">
                        <font><Font size="14.0"/></font>
                    </Label>
                </VBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>