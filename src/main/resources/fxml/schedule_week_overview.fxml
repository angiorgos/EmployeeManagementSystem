<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="weekRoot"
      spacing="10"
      prefWidth="900"
      prefHeight="600"
      VBox.vgrow="ALWAYS"
      style="-fx-padding: 10;">

    <!-- WEEK TITLE / RANGE -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Week: 6 Jan – 12 Jan 2026"
               style="-fx-font-size: 16; -fx-font-weight: bold;" />
    </HBox>

    <!-- SEARCH / FILTER BAR -->
    <HBox spacing="10">
        <TextField promptText="Search employee..." prefWidth="250"/>
        <!-- future: department filter -->
    </HBox>

    <!-- MAIN CONTENT -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="12">

            <!-- Day section -->
            <VBox styleClass="week-day-card">
                <Label text="Monday" style="-fx-font-weight: bold;"/>

                <HBox styleClass="shift-row">
                    <Label text="09:00 – 19:00" prefWidth="120"/>
                    <Label text="Maria Pap."/>
                </HBox>

                <HBox styleClass="shift-row">
                    <Label text="09:00 – 20:00" prefWidth="120"/>
                    <Label text="Dimitris Ar."/>
                </HBox>
            </VBox>

            <!-- repeat for Tue..Sun -->

        </VBox>
    </ScrollPane>

</VBox>