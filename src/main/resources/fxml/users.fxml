<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1366.0"
            stylesheets="@../theme.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.project.employeemanagementsystem.controller.UsersController">

    <top>
        <fx:include source="topbar.fxml"/>
    </top>

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <center>
        <StackPane>

            <!-- ================= TABLE VIEW ================= -->

            <VBox fx:id="tableViewContainer" spacing="20"
                  style="-fx-padding: 20; -fx-background-color: #F3F4F6;">

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Users Management" styleClass="page-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: white; -fx-padding: 15;
                             -fx-background-radius: 8;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5,0,0,2);">

                    <TextField fx:id="searchField"
                               prefWidth="250"
                               promptText="Search..."
                               styleClass="search-field"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="+ Add User"
                            onAction="#onCreateUser"
                            styleClass="btn-primary"/>

                    <!-- ❌ ADD ROLE BUTTON DISABLED -->
                    <!--
                    <Button text="+ Add Role"
                            onAction="#onCreateRole"
                            styleClass="btn-primary"/>
                    -->

                    <Button text="Refresh"
                            onAction="#handleRefresh"
                            styleClass="btn-secondary"/>
                </HBox>

                <TableView fx:id="usersTable"
                           VBox.vgrow="ALWAYS"
                           styleClass="styled-table">

                    <columns>
                        <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="usernameCol" text="Username" prefWidth="200"/>

                        <!-- ✅ ROLE COLUMN KEPT -->
                        <TableColumn fx:id="roleCol" text="Role" prefWidth="200"/>

                        <TableColumn fx:id="actionCol" text="Actions" prefWidth="180"/>
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                </TableView>
            </VBox>

            <!-- ================= USER FORM ================= -->

            <VBox fx:id="formViewContainer"
                  visible="false"
                  spacing="20"
                  style="-fx-padding: 30;
                         -fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10,0,0,0);">

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="← Back"
                            onAction="#handleBackToTable"
                            styleClass="btn-secondary"/>
                    <Label fx:id="formTitle"
                           text="New User"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                </HBox>

                <Separator/>

                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <!-- USERNAME -->
                    <VBox GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <Label text="Username *" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="usernameField" styleClass="search-field"/>
                    </VBox>

                    <!-- PASSWORD -->
                    <VBox GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <Label text="Password" style="-fx-font-weight: bold;"/>
                        <PasswordField fx:id="passwordField" styleClass="search-field"/>
                    </VBox>

                    <!-- ✅ ROLE COMBOBOX KEPT -->
                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <Label text="Role *" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="roleComboBox"
                                  maxWidth="Infinity"
                                  styleClass="search-field"/>
                    </VBox>

                    <!-- ✅ EMPLOYEE COMBOBOX -->
                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <Label text="Employee *" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="employeeComboBox"
                                  maxWidth="Infinity"
                                  styleClass="search-field"/>
                    </VBox>
                </GridPane>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button text="Cancel"
                            onAction="#handleBackToTable"
                            styleClass="btn-secondary"/>
                    <Button text="Save User"
                            onAction="#onSaveUser"
                            prefWidth="150"
                            styleClass="btn-primary"/>
                </HBox>

            </VBox>

            <!-- ================= LOADING OVERLAY ================= -->

            <VBox fx:id="loadingOverlay"
                  alignment="CENTER"
                  spacing="20"
                  style="-fx-background-color: #F3F4F6;">

                <ProgressIndicator prefWidth="60" prefHeight="60"/>

                <VBox alignment="CENTER" spacing="5">
                    <Label text="Loading Users">
                        <font>
                            <Font name="System Bold" size="20"/>
                        </font>
                    </Label>
                    <Label text="Please wait...">
                        <font>
                            <Font size="14"/>
                        </font>
                    </Label>
                </VBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
